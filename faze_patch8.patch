+const fs = require('fs');
+const path = require('path');
+const { JSDOM, VirtualConsole } = require('jsdom');
+
+const WEB = path.join(__dirname, '..', 'web');
+const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
+const errors = [];
+const calls = [];
+let ops = 0;
