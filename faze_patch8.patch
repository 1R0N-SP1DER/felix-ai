+    def test_group_chats(self):
+        res = node("""
+          const now = new Date(2026, 9, 6, 15, 0).getTime(); const H = 3600000, D = 86400000;
+          const c = (id, ago, extra) => Object.assign({ id, title: id, updated: now - ago, messages: [] }, extra || {});
