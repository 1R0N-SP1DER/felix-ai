+class GateProc:
+    """A speech process that runs until released."""
+    def __init__(self, argv):
+        self.argv, self.released, self.terminated = argv, threading.Event(), False
+
+    def poll(self):
+        if self.terminated:
+            return -15
+        return 0 if self.released.is_set() else None
+
+    def terminate(self):
+        self.terminated = True
+
