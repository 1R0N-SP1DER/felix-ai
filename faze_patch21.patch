new file mode 100644
index 0000000..62091e4
--- /dev/null
+++ b/core/live_client.py
@@ -0,0 +1,288 @@
+"""
+felix-ai Core -- live_client.py
+A small client for the Gemini Live API (bidirectional audio over a WebSocket), used only by the dedicated live voice
+mode (`faze start --live`). Needs the `websockets` package (pip install websockets); everything else is standard library.
+
+    conn = LiveConnection(key, "gemini-3.8-live")
+    conn.open(instruction, declarations, search=True, voice="Kore")   # raises LiveError if it cannot be set up
+    conn.send_audio(pcm16_16k)                                        # as often as you like
+    for event in conn.poll(0.2): ...                                  # ("audio", bytes) ("in_text", s) ("out_text", s)
+                                                                       # ("tool_call", [{id,name,args}]) ("turn_complete",)
+                                                                       # ("interrupted",) ("go_away", s) ("closed", why)
+
+The message layout follows Google's Live API docs. Those docs show the output settings in two places (inside
+generationConfig, and flat on the setup message), so setup is tried in both shapes, and without Google Search as
+a last resort, when the server rejects a field by name. Every rejection is kept for the error message.
+The API key never appears in an error or a log line.
+"""
+
+import base64
+import json
+import re
+import shutil
+import subprocess
+import threading
+import time
+import warnings
+
+try:
+    from websockets.exceptions import ConnectionClosed
+    from websockets.sync.client import connect as _ws_connect
+except ImportError:  # the live mode reports this; nothing else needs the package
+    _ws_connect, ConnectionClosed = None, None
+
+URL = "wss://generativelanguage.googleapis.com/ws/google.ai.generativelanguage.v1beta.GenerativeService.BidiGenerateContent?key={key}"
+INPUT_RATE = 16000
+OUTPUT_RATE = 24000
+SETUP_TIMEOUT = 12.0
+_RETRYABLE = re.compile(r"unknown name|invalid json|invalid argument|cannot find field|unsupported|not supported|tools?\b", re.IGNORECASE)
+
+
+class LiveError(Exception):
+    pass
+
+
+def available() -> bool:
+    return _ws_connect is not None
+
+
+def scrub(text: str) -> str:
+    return re.sub(r"key=[^&\s'\"]+", "key=...", str(text))
+
+
+def build_setup(model: str, instruction: str, declarations: list, search: bool, voice: str, shape: str) -> dict:
+    """The first message. shape "generation": output settings inside generationConfig; "flat": on the setup itself."""
+    speech = {"voiceConfig": {"prebuiltVoiceConfig": {"voiceName": voice}}}
+    setup = {
+        "model": model if model.startswith("models/") else "models/" + model,
+        "systemInstruction": {"parts": [{"text": instruction}]},
+        "inputAudioTranscription": {},
+        "outputAudioTranscription": {},
+    }
+    if shape == "generation":
+        setup["generationConfig"] = {"responseModalities": ["AUDIO"], "speechConfig": speech}
+    else:
+        setup["responseModalities"] = ["AUDIO"]
+        setup["speechConfig"] = speech
+    tools = []
+    if search:
+        tools.append({"googleSearch": {}})
+    if declarations:
+        tools.append({"functionDeclarations": declarations})
+    if tools:
+        setup["tools"] = tools
+    return {"setup": setup}
+
+
+def parse_message(msg: dict) -> list:
+    """One server message as a list of events."""
+    events = []
+    content = msg.get("serverContent") or {}
+    for part in (content.get("modelTurn") or {}).get("parts") or []:
+        inline = part.get("inlineData")
+        if inline and inline.get("data"):
+            events.append(("audio", base64.b64decode(inline["data"])))
+        elif part.get("text"):
+            events.append(("text", part["text"]))
+    if (content.get("inputTranscription") or {}).get("text"):
+        events.append(("in_text", content["inputTranscription"]["text"]))
+    if (content.get("outputTranscription") or {}).get("text"):
+        events.append(("out_text", content["outputTranscription"]["text"]))
+    if content.get("interrupted"):
+        events.append(("interrupted",))
+    if content.get("turnComplete"):
+        events.append(("turn_complete",))
+    calls = (msg.get("toolCall") or {}).get("functionCalls")
+    if calls:
+        events.append(("tool_call", [{"id": c.get("id", ""), "name": c.get("name", ""), "args": c.get("args") or {}} for c in calls]))
+    if msg.get("goAway") is not None:
+        events.append(("go_away", str((msg["goAway"] or {}).get("timeLeft", ""))))
+    return events
+
+
+class LiveConnection:
+    def __init__(self, key: str, model: str, connect=None, clock=time.monotonic):
+        self.key, self.model = key, model
+        self._connect = connect or _ws_connect
+        self._clock = clock
+        self.ws = None
+        self.shape = ""
+        self.search = False
+        self.rejections = []
+        self._send_lock = threading.Lock()
+        self.closed = ""
+
+    # ---- setup -------------------------------------------------------------
+
+    def open(self, instruction: str, declarations: list, search: bool = True, voice: str = "Kore") -> None:
+        if self._connect is None:
+            raise LiveError("the websockets package is not installed (pip install websockets)")
+        attempts = [("generation", search), ("flat", search)] + ([("generation", False), ("flat", False)] if search else [])
+        for shape, with_search in attempts:
+            try:
+                with warnings.catch_warnings():  # newer websockets prefer `with connect(...)`; a long-lived socket cannot
+                    warnings.simplefilter("ignore", DeprecationWarning)
+                    ws = self._connect(URL.format(key=self.key), open_timeout=SETUP_TIMEOUT, max_size=None)
+            except Exception as e:
+                raise LiveError("could not connect: " + scrub(e)[:160])
+            try:
+                ws.send(json.dumps(build_setup(self.model, instruction, declarations, with_search, voice, shape)))
+                first = self._load(ws.recv(timeout=SETUP_TIMEOUT))
+            except Exception as e:
+                reason = self._reason(e)
+                self._shut(ws)
+                self.rejections.append(f"{shape}{'' if with_search else ' no-search'}: {reason}")
+                if _RETRYABLE.search(reason):
+                    continue
+                raise LiveError(reason)
+            if "setupComplete" in first:
+                self.ws, self.shape, self.search = ws, shape, with_search
+                return
+            self._shut(ws)
+            raise LiveError("the server did not confirm the setup: " + scrub(json.dumps(first))[:160])
+        raise LiveError("setup was refused: " + " | ".join(self.rejections)[:400])
+
+    @staticmethod
+    def _reason(e: Exception) -> str:
+        rcvd = getattr(e, "rcvd", None)
+        if rcvd is not None and (rcvd.reason or rcvd.code):
+            return scrub(f"{rcvd.code}: {rcvd.reason}".strip(": "))[:300]
+        return scrub(f"{type(e).__name__}: {e}")[:300]
+
+    def _close_reason(self) -> str:
+        """Why the connection is closed, from the protocol state ("" while it is open)."""
+        proto = getattr(self.ws, "protocol", None)
+        code = getattr(proto, "close_code", None)
+        if code is None:
+            return ""
+        return scrub(f"{code}: {getattr(proto, 'close_reason', '') or ''}".strip(": "))[:300]
+
+    @staticmethod
+    def _load(raw) -> dict:
+        if isinstance(raw, (bytes, bytearray)):
+            raw = raw.decode("utf-8", "replace")
+        try:
+            return json.loads(raw)
+        except ValueError:
+            raise LiveError("the server sent something unreadable")
+
+    @staticmethod
+    def _shut(ws) -> None:
+        try:
+            ws.close()
+        except Exception:
+            pass
+
+    # ---- traffic -----------------------------------------------------------
+
+    def _send(self, payload: dict) -> None:
+        try:
+            with self._send_lock:
+                self.ws.send(json.dumps(payload))
+        except Exception as e:
+            self.closed = self.closed or self._reason(e)  # a dead socket seen while sending is a close, even if recv has not noticed
+            raise
+
+    def send_audio(self, pcm: bytes) -> None:
+        self._send({"realtimeInput": {"audio": {"data": base64.b64encode(pcm).decode(), "mimeType": f"audio/pcm;rate={INPUT_RATE}"}}})
+
+    def send_text(self, text: str) -> None:
+        self._send({"realtimeInput": {"text": text}})
+
+    def end_audio(self) -> None:
+        self._send({"realtimeInput": {"audioStreamEnd": True}})
+
+    def send_tool_responses(self, responses: list) -> None:
+        """responses: [{"id", "name", "ok", "text"}]"""
+        self._send({"toolResponse": {"functionResponses": [
+            {"id": r["id"], "name": r["name"], "response": {"result": r["text"]} if r["ok"] else {"error": r["text"]}}
+            for r in responses]}})
+
+    def poll(self, timeout: float = 0.2) -> list:
+        """Events that arrived within `timeout` seconds (maybe none). A dropped connection is a ("closed", why) event."""
+        if self.closed:
+            return [("closed", self.closed)]
+        try:
+            raw = self.ws.recv(timeout=timeout)
+        except TimeoutError:
+            why = self._close_reason()
+            if why:
+                self.closed = why
+                return [("closed", why)]
+            return []
+        except Exception as e:
+            self.closed = self._reason(e)
+            return [("closed", self.closed)]
+        try:
+            return parse_message(self._load(raw))
+        except LiveError as e:
+            return [("closed", str(e))]
+
+    def close(self) -> None:
+        if self.ws is not None:
+            self._shut(self.ws)
+        self.closed = self.closed or "closed"
+
+
+class PcmPlayer:
+    """Plays raw 24 kHz mono PCM as it arrives, through the first player the phone has (pacat from PulseAudio, else ffplay).
+    `live.player` can name another command that reads s16le 24 kHz mono from stdin."""
+
+    CANDIDATES = (
+        ["pacat", "--playback", "--format=s16le", f"--rate={OUTPUT_RATE}", "--channels=1", "--latency-msec=120"],
+        ["ffplay", "-nodisp", "-autoexit", "-loglevel", "quiet", "-f", "s16le", "-ar", str(OUTPUT_RATE), "-ac", "1", "-i", "pipe:0"],
+    )
+
+    def __init__(self, override: str = "", popen=subprocess.Popen, which=shutil.which):
+        self._popen, self._which, self.override = popen, which, override.strip()
+        self.proc = None
+        self.command = None
+
+    def command_line(self):
+        if self.override:
+            import shlex
+            return shlex.split(self.override)
+        for cmd in self.CANDIDATES:
+            if self._which(cmd[0]):
+                return list(cmd)
+        return None
+
+    def usable(self) -> bool:
+        return self.command_line() is not None
+
+    def write(self, pcm: bytes) -> None:
+        if self.proc is None or self.proc.poll() is not None:
+            cmd = self.command_line()
+            if cmd is None:
+                raise LiveError("no audio player: install pulseaudio (pacat) or ffmpeg (ffplay), or set live.player")
+            self.command = cmd
+            self.proc = self._popen(cmd, stdin=subprocess.PIPE, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+        try:
+            self.proc.stdin.write(pcm)
+            self.proc.stdin.flush()
+        except (BrokenPipeError, OSError, ValueError):
+            self.proc = None
+
+    def finish(self) -> None:
+        """No more audio for this turn: the player plays what it has buffered, then exits."""
+        if self.proc is not None:
+            try:
+                self.proc.stdin.close()
+            except (OSError, ValueError):
+                pass
+
+    def busy(self) -> bool:
+        return self.proc is not None and self.proc.poll() is None
+
+    def stop(self) -> None:
+        """Silence now (an interruption or Stop)."""
+        proc, self.proc = self.proc, None
+        if proc is not None:
+            try:
+                proc.stdin.close()
+            except (OSError, ValueError):
+                pass
+            try:
+                proc.terminate()
+            except OSError:
+                pass
diff --git a/core/live_voice.py b/core/live_voice.py
new file mode 100644
index 0000000..21aba58
--- /dev/null
+++ b/core/live_voice.py
@@ -0,0 +1,203 @@
+"""
+felix-ai Core -- live_voice.py
+The dedicated live voice mode: a spoken conversation with Gemini Live, run on the server. `faze start --live` starts it;
+the overlay shows it. The classic voice pipeline (faze start --voice) is untouched.
+
+The wake listener's microphone stream goes up to Gemini as 16 kHz PCM; Gemini's 24 kHz audio comes back and is played
+as it arrives; both sides' transcripts, tool calls (run here, with the usual permission and phone-control gates) and
+Google Search all happen inside the one session. By default the microphone is muted while Gemini speaks (the phone's own
+speaker would otherwise be heard as you interrupting); live.barge_in turns interruption on, best with headphones.
+
+LiveUnavailable means nothing was said yet and the caller can fall back to the classic pipeline.
+"""
+
+import os
+import threading
+import time
+
+import action_log
+import live_client
+import net_status
+from live_client import LiveConnection, LiveError, PcmPlayer
+
+TAIL_S = 0.35          # microphone stays muted this long after Gemini stops
+MAX_TOOL_TEXT = 4000
+NEVER_IN_LIVE = {"listen", "create_tool"}  # listen would fight for the microphone; creating tools needs the app's approval card
+VOICE_NOTE = (
+    "\nYou are speaking aloud in a live voice conversation. Answer in one to three short, natural sentences; no markdown, "
+    "no lists, no emojis, nothing that is awkward to say out loud. Use tools for anything about this phone, and Google "
+    "Search for current facts if you have it. If a tool fails, say so in a few words instead of guessing.\n")
+
+
+class LiveUnavailable(Exception):
+    pass
+
+
+def declarations(convo, with_search: bool) -> list:
+    import agent
+    from gemini_client import _tools_to_function_declarations
+    skip = set(NEVER_IN_LIVE) | ({"search_web"} if with_search else set())
+    schema = [t for t in agent.gemini_schema(convo.config) if t["function"]["name"] not in skip]
+    return _tools_to_function_declarations(schema)
+
+
+def run(session, gen: int, cancel: threading.Event, connect=None, player=None, clock=time.monotonic) -> None:
+    from voice_session import DONE, ERROR, LISTENING, SPEAKING, THINKING
+    server, convo = session.server, session.server.convo
+    cfg = server.config
+    live = cfg["live"]
+    key = os.environ.get("GEMINI_API_KEY", "")
+    if not key:
+        raise LiveUnavailable("no GEMINI_API_KEY")
+    if connect is None and not live_client.available():
+        raise LiveUnavailable("the websockets package is not installed (pip install websockets)")
+    if not net_status.online(cfg):
+        raise LiveUnavailable("offline")
+    listener = server.wake
+    if listener is None or not listener._live():
+        raise LiveUnavailable("it needs the wake listener's microphone stream (turn on wake.enabled)")
+    player = player or PcmPlayer(live.get("player", ""))
+    if not player.usable():
+        raise LiveUnavailable("no audio player: install pulseaudio (pacat) or ffmpeg (ffplay), or set live.player")
+    if not server.chat_lock.acquire(blocking=False):
+        session._set(gen, state=ERROR, error="Faze is still answering the last message")
+        return
+
+    started = clock()
+    marks = {}
+    conn = LiveConnection(key, str(live.get("model") or "gemini-3.8-live"), connect=connect)
+    stop_mic = threading.Event()
+    barge_in = bool(live.get("barge_in", False))
+    idle_limit = float(live.get("idle_seconds", 15))
+    max_seconds = float(live.get("max_seconds", 600))
+    held = False
+    try:
+        with_search = bool(live.get("search", True))
+        try:
+            conn.open(convo.system_static + VOICE_NOTE, declarations(convo, with_search), with_search,
+                      voice=str(cfg["tts"]["voice"]).capitalize())
+        except LiveError as e:
+            raise LiveUnavailable(str(e))
+        marks["connect"] = clock()
+        if not conn.search:
+            with_search = False
+        listener.hold(True)
+        held = True
+
+        state = {"speaking": False, "turn_done": False, "gate_until": 0.0, "activity": clock(), "turns": 0, "ending": False}
+        text = {"user": "", "reply": ""}
+        timing = {}
+
+        def mic_open() -> bool:
+            if barge_in:
+                return True
+            return not state["speaking"] and not player.busy() and clock() >= state["gate_until"]
+
+        def mic():
+            try:
+                for frame in listener.frames(stop_mic):
+                    if stop_mic.is_set() or cancel.is_set():
+                        return
+                    if mic_open():
+                        conn.send_audio(frame)
+            except Exception as e:  # a closed socket ends the mic quietly; the receiver reports it
+                action_log.log_action("live", "mic", {}, f"stopped: {e}", 0, echo=False)
+
+        threading.Thread(target=mic, daemon=True).start()
+        end_note = ""
+
+        def listening():
+            state.update(speaking=False, turn_done=False, gate_until=clock() + TAIL_S, activity=clock())
+            session._set(gen, state=LISTENING)
+
+        def new_turn_if_needed():
+            if state["turn_done"] or text["reply"]:
+                text["user"], text["reply"] = "", ""
+                state["turn_done"] = False
+                session._set(gen, transcript="", reply="")
+
+        def finish_timing():
+            t = {"connect_ms": int((marks["connect"] - started) * 1000), "turns": state["turns"]}
+            if "audio" in timing and "user" in timing:
+                t["first_audio_ms"] = max(0, int((timing["audio"] - timing["user"]) * 1000))
+            return t
+
+        while not cancel.is_set():
+            now = clock()
+            if now - started > max_seconds:
+                end_note = "Live session time limit reached"
+                break
+            events = conn.poll(0.2)
+            if not events:
+                if state["speaking"] and state["turn_done"] and not player.busy():
+                    listening()
+                if state["ending"] and not state["speaking"]:
+                    break
+                if (not state["speaking"] and not state["turn_done"] and now - state["activity"] > idle_limit
+                        and not text["user"] and not text["reply"]):
+                    end_note = end_note or "Conversation ended (nobody spoke)"
+                    break
+                if not state["speaking"] and now - state["activity"] > idle_limit * 2:
+                    end_note = end_note or "Conversation ended (idle)"
+                    break
+                continue
+            state["activity"] = now
+            ended = False
+            for ev in events:
+                kind = ev[0]
+                if kind == "in_text":
+                    new_turn_if_needed()
+                    text["user"] += ev[1]
+                    timing["user"] = now
+                    session._set(gen, transcript=text["user"].strip())
+                elif kind == "out_text":
+                    text["reply"] += ev[1]
+                    session._set(gen, reply=text["reply"].strip(), state=SPEAKING if state["speaking"] else THINKING)
+                elif kind == "audio":
+                    if not state["speaking"]:
+                        state["speaking"] = True
+                        timing["audio"] = now
+                        marks.setdefault("first_audio", now)
+                        session._set(gen, state=SPEAKING)
+                    player.write(ev[1])
+                elif kind == "tool_call":
+                    session._set(gen, state=THINKING)
+                    responses = []
+                    for call in ev[1]:
+                        ok, out = convo._execute_tool(call["name"], call["args"], "live")
+                        responses.append({"id": call["id"], "name": call["name"], "ok": ok, "text": str(out)[:MAX_TOOL_TEXT]})
+                    conn.send_tool_responses(responses)
+                elif kind == "interrupted":
+                    player.stop()
+                    listening()
+                elif kind == "turn_complete":
+                    state["turns"] += 1
+                    state["turn_done"] = True
+                    player.finish()
+                    if not state["speaking"]:
+                        listening()
+                elif kind == "go_away":
+                    end_note = "Live session is ending soon"
+                    state["ending"] = True
+                elif kind == "closed":
+                    if state["turns"] == 0 and not text["user"]:
+                        session._set(gen, state=ERROR, error="the Live session closed: " + str(ev[1])[:160])
+                        return
+                    end_note = "Live session closed" + (f" ({str(ev[1])[:80]})" if ev[1] and "1000" not in str(ev[1]) else "")
+                    ended = True
+                    break
+            if ended or (state["ending"] and state["turn_done"] and not player.busy()):
+                break
+        if not cancel.is_set():
+            t = finish_timing()
+            action_log.log_action("live", "timings", t, end_note or "ended", 0, echo=False)
+            session._set(gen, state=DONE, timings=t, note=end_note or "Conversation ended")
+    except LiveError as e:
+        session._set(gen, state=ERROR, error=str(e)[:200])
+    finally:
+        stop_mic.set()
+        player.stop()
+        conn.close()
+        if held:
+            listener.hold(False)
+        server.chat_lock.release()
